# ============================
# LectureMIND — Environment Template
# ============================
# Copy to `.env` and adjust for your machine. All variables are optional —
# every setting has a sensible default in config.py. This file is committed
# as a template; `.env` itself is gitignored (never commit real keys).

# --- Backend services ----------------------------------------------------
# Neo4j bolt URI (local docker-compose: bolt://localhost:7687)
NEO4J_URI=bolt://localhost:7687
# Qdrant REST URL (local docker-compose: http://localhost:6333)
QDRANT_URL=http://localhost:6333

# --- Local LLM (Ollama) --------------------------------------------------
# Default model pulled/used for answer generation.
OLLAMA_MODEL=qwen2.5:3b
# Pull missing Ollama models automatically at runtime.
ENABLE_AUTO_OLLAMA_PULL=true

# --- Models --------------------------------------------------------------
# Directory for downloaded models (reranker + embedding cache).
LOCAL_MODEL_DIR=local_runtime/models/
# Global reranker directory — fine-tuned model lives here; if missing, the
# app downloads RERANKER_MODEL_ID from Hugging Face at startup.
GLOBAL_RERANKER_DIR=local_runtime/models/global_reranker/
# Hugging Face reranker to use when no fine-tuned model is present.
RERANKER_MODEL_ID=BAAI/bge-reranker-base
# Load reranker + embedding models automatically at startup.
ENABLE_AUTO_MODEL_RECOVERY=true
# Dynamic int8 quantization for the reranker (~3.7x CPU speedup, identical
# ranking). Set true to enable; falls back to FP32 automatically on failure.
RERANKER_QUANTIZE=false

# --- Uploads -------------------------------------------------------------
# Max model ZIP upload size in MB (reranker fine-tune files).
MAX_MODEL_UPLOAD_MB=2000
# Max knowledge-package ZIP upload size in MB.
MAX_PACKAGE_UPLOAD_MB=2000
# Temp directories used during upload/import.
UPLOAD_TEMP_DIR=local_runtime/temp/uploads/
LOCAL_UPLOAD_DIR=local_runtime/uploads/

# --- Storage / transfer --------------------------------------------------
TRANSFER_DIR=transfer/
LOCAL_LOG_DIR=local_runtime/logs/
LOCAL_CACHE_DIR=local_runtime/cache/

# --- Cloud (Kaggle ingestion only — not needed for local runtime) --------
# These are only read by cloud/ modules. Leave unset unless you run the
# cloud ingestion pipeline yourself.
# KAGGLE_OUTPUT_ROOT=/kaggle/working
# OCR_USE_GPU=false
# KAFKA_BROKER=localhost:9092
