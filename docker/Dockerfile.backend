# Backend Dockerfile
FROM python:3.12-slim

WORKDIR /app

# System deps for numpy, etc.
RUN apt-get update && apt-get install -y --no-install-recommends gcc && rm -rf /var/lib/apt/lists/*

# Install Python dependencies.
# NOTE: local_requirements.txt is the API runtime stack (FastAPI, Qdrant,
# Neo4j, LLM SDKs, sentence-transformers). requirements.txt is the
# cloud/GPU-only ingestion stack (torch/paddle/whisper) and would
# massively bloat the image and break CPU builds.
COPY local_requirements.txt .
RUN pip install --no-cache-dir -r local_requirements.txt

# Copy source code.
COPY schemas/ schemas/
COPY config.py .
COPY local/ local/
COPY agent/ agent/
COPY retrieval/ retrieval/
COPY serving/ serving/

EXPOSE 8000

CMD ["uvicorn", "serving.fastapi.app:app", "--host", "0.0.0.0", "--port", "8000"]
